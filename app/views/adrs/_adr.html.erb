<div class="border p-4 mb-2 rounded shadow">
  <div class="flex justify-between items-start mb-2">
    <div>
      <h2 class="text-xl font-semibold"><%= adr.title %></h2>
      <p class="text-sm text-gray-600">Status: <span class="font-medium <%= 'text-green-600' if adr.status == 'ACCEPTED' %><%= 'text-yellow-600' if adr.status == 'SUPERSEDED' %>"><%= adr.status %></span></p>
    </div>
    <div class="flex gap-2 items-center">
      <% if adr.status == "PROPOSED" %>
        <%= button_to "Approve", adr_path(adr), method: :patch,
          params: { adr: { status: "ACCEPTED" } },
          class: "bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-sm transition-colors" %>
      <% elsif adr.status == "ACCEPTED" %>
        <%= button_to "Supersede", adr_path(adr), method: :put,
          params: { adr: { status: "SUPERSEDED" } },
          class: "bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded text-sm transition-colors" %>
        <button class="text-yellow-600 hover:text-yellow-800 transition-colors ml-2" data-action="click->form-toggle#showSupersede" title="Replace this ADR">
          <i class="fas fa-exchange-alt"></i>
        </button>
      <% end %>
    </div>
  </div>
  
  <div class="mt-3">
    <p><strong>Context:</strong> <%= adr.context %></p>
    <p><strong>Decision:</strong> <%= adr.decision %></p>
    <p><strong>Consequences:</strong> <%= adr.consequences %></p>
  </div>
</div>
