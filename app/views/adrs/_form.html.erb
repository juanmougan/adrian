<div class="bg-gray-50 p-4 rounded-lg border">
  <%= form_with url: adrs_path, method: :post, scope: :adr, data: { turbo_stream: true } do |form| %>
    <div class="mb-4">
      <%= form.label :title, class: "block font-medium mb-1" %>
      <%= form.text_field :title, class: "border rounded w-full p-2" %>
    </div>

    <div class="mb-4">
      <%= form.label :context, class: "block font-medium mb-1" %>
      <%= form.text_area :context, rows: 3, class: "border rounded w-full p-2" %>
    </div>

    <div class="mb-4">
      <%= form.label :decision, class: "block font-medium mb-1" %>
      <%= form.text_area :decision, rows: 3, class: "border rounded w-full p-2" %>
    </div>

    <div class="mb-4">
      <%= form.label :consequences, class: "block font-medium mb-1" %>
      <%= form.text_area :consequences, rows: 3, class: "border rounded w-full p-2" %>
    </div>

    <div class="flex gap-2">
      <%= form.submit "Create ADR", class: "bg-blue-600 text-white rounded px-4 py-2 hover:bg-blue-700 transition-colors" %>
      <button type="button" class="bg-gray-500 text-white rounded px-4 py-2 hover:bg-gray-600 transition-colors" data-action="click->form-toggle#hide">Cancel</button>
    </div>
  <% end %>
</div>
